# Copy to .env and fill in. Consumed by docker-compose.yml.

# Host directory holding the GGUF model (bind-mounted read-only at /models)
NOTANDA_MODEL_DIR=/opt/notanda/models
# Path INSIDE the container — must match a file in the directory above
NOTANDA_MODEL_PATH=/models/cohere-transcribe-arabic-07-2026-Q8_0.gguf

NOTANDA_ASR_BACKEND=transcribe_cpp
# 3 of the box's 4 cores; one is left for the API, ffmpeg, VAD and nginx
NOTANDA_TRANSCRIBE_THREADS=3

# Required for post-meeting summaries
ANTHROPIC_API_KEY=
NOTANDA_SUMMARY_MODEL=claude-haiku-4-5
