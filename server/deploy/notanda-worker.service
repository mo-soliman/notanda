[Unit]
Description=Notanda transcription worker
After=network.target

[Service]
User=__USER__
WorkingDirectory=__SERVER_DIR__
EnvironmentFile=/etc/notanda/env
ExecStart=/home/__USER__/.local/bin/uv run python -m notanda_server.worker
Restart=always
RestartSec=3
MemoryMax=6G

[Install]
WantedBy=multi-user.target
